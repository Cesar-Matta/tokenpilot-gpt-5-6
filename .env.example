# SERVER ONLY. The standalone Codex skill does not use this file or require an API key.
# Required only for POST /v1/responses. Never commit real values.
OPENAI_API_KEY=

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Set true in every shared or public deployment. Use a comma-separated key set.
REQUIRE_API_KEY=false
TOKENPILOT_API_KEYS=

# Comma-separated browser origins. Keep empty to disable browser CORS.
ALLOWED_ORIGINS=
REQUEST_RATE_LIMIT_PER_MINUTE=60
MAX_INPUT_CHARACTERS=500000
REQUEST_TIMEOUT_SECONDS=90
LONG_CONTEXT_TOKEN_THRESHOLD=128000

# Optional hard cap applied independently to every provider attempt.
DEFAULT_REQUEST_BUDGET_USD=

# Set true when readiness must require OPENAI_API_KEY and execution capability.
REQUIRE_OPENAI_FOR_READINESS=false
